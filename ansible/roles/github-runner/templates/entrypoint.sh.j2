#!/usr/bin/env bash
# {{ ansible_managed }}
set -euo pipefail

export DEBIAN_FRONTEND=noninteractive
export RUNNER_ALLOW_RUNASROOT=1

apt-get update -qq
# libicu74/libssl3/libkrb5-3/zlib1g는 러너(.NET 런타임)가 요구하는 의존성이다. 러너에 내장된
# bin/installdependencies.sh는 오래된 Ubuntu 버전 패키지명(예: libicu52)만 알아서 24.04(noble)에서
# 실패하므로 직접 최신 패키지명을 설치한다. github_runner_image를 다른 Ubuntu 버전으로 바꾸면
# 이 패키지명도 맞춰 바꿔야 할 수 있다.
apt-get install -y -qq --no-install-recommends \
  curl ca-certificates git jq openssh-client python3-pip unzip sudo \
  libicu74 libssl3 libkrb5-3 zlib1g \
  {{ github_runner_extra_packages }} >/dev/null
pip3 install --break-system-packages --quiet ansible >/dev/null

cd /actions-runner

if [ ! -f config.sh ]; then
  if [ ! -f actions-runner.tar.gz ]; then
    curl -fsSL -o actions-runner.tar.gz \
      "https://github.com/actions/runner/releases/download/v{{ github_runner_version }}/actions-runner-linux-{{ github_runner_arch }}-{{ github_runner_version }}.tar.gz"
  fi
  tar xzf actions-runner.tar.gz
fi

if [ ! -f .runner ]; then
  # 등록 토큰은 1시간 내 만료되므로 매 최초 기동 시 PAT로 새로 발급받는다.
  REG_TOKEN=$(curl -fsSL -X POST \
    -H "Authorization: Bearer {{ github_runner_pat }}" \
    -H "Accept: application/vnd.github+json" \
    "https://api.github.com/repos/{{ github_runner_repo }}/actions/runners/registration-token" \
    | jq -r .token)

  ./config.sh --unattended --replace \
    --url "https://github.com/{{ github_runner_repo }}" \
    --token "$REG_TOKEN" \
    --name "{{ github_runner_name }}" \
    --labels "{{ github_runner_labels }}" \
    --work _work
fi

exec ./run.sh
