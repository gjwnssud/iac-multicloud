*.pem
*.key
secrets.yml
secrets.yaml
.env

# Node.js
node_modules/
dist/

# OS / editor
.DS_Store
.idea/
.vscode/

# 전역 gitignore(~/.gitignore_global)가 CLAUDE.md를 제외하지만
# 이 저장소는 계획 문서로 커밋 관리한다.
!CLAUDE.md
